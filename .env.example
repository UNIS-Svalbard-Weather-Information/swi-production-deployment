# Replica count for mapproxy-server, met-public-api and met-tilling-api (elevation_api
# always runs 1, it's already minimal). 3 is the production default - for local
# development, override this to 1 in your own .env (see README.md's "Run it locally").
SWI_SERVICE_REPLICAS=3

# Shared Redis instance (mapproxy tile cache + met-public-api response cache)
SWI_REDIS_PWD=ThisMustBeAStrongPassword

# MapServices Specific
SWI_SEAICE_MONITORING_ENDPOINT=http://127.0.0.1
SWI_AVALANCHE_MONITORING_ENDPOINT=http://127.0.0.1


#CORS
CORS_ALLOWED_ORIGINS=*

# Routes
SWI_MAPPROXY_HOST=mapserver.localhost

SWI_APIS_HOST=api.localhost
SWI_ELEVATION_API_ROUTE=/oeapi/

SWI_METOBS_API_ROUTE=/public/
SWI_METOBS_INTERNAL_PORT=8085

SWI_TITILER_API_ROUTE=/tiles/


#APIs key
SWI_METOBS_HOLFUY_API_KEY=TheHolfuyAPIKey
SWI_METOBS_FROST_API_KEY=TheFrostAPIKey