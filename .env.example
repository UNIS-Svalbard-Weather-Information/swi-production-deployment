# Replica counts. 3 is the production default for the scaled services; staging sets
# mapproxy and titiler to 1 (metobs stays at 3). For local development, override all of
# them to 1 in your own .env (see README.md's "Run it locally"). elevation_api always
# runs 1, it's already minimal.
SWI_MAPPROXY_REPLICAS=3
SWI_TITILER_REPLICAS=3
SWI_METOBS_REPLICAS=3
SWI_FRONTEND_REPLICAS=1

# Shared Redis instance (mapproxy tile cache + met-public-api response cache)
SWI_REDIS_PWD=ThisMustBeAStrongPassword

# MapServices Specific
SWI_SEAICE_MONITORING_ENDPOINT=http://127.0.0.1
SWI_AVALANCHE_MONITORING_ENDPOINT=http://127.0.0.1


#CORS
# In production (frontend in direct mode) this must contain the frontend origin,
# e.g. https://portal.example.org
CORS_ALLOWED_ORIGINS=*

# Routes
SWI_FRONTEND_HOST=portal.localhost

SWI_MAPPROXY_HOST=mapserver.localhost

SWI_APIS_HOST=api.localhost
SWI_ELEVATION_API_ROUTE=/oeapi/
# Optional: use another DTM archive for elevation_api (empty = 20 m model). Smaller one for tests:
# SWI_ELEVATION_DTM_URL=https://public.data.npolar.no/kartdata/S0_Terrengmodell/Mosaikk/NP_S0_DTM50.zip

SWI_METOBS_API_ROUTE=/public/
SWI_METOBS_INTERNAL_PORT=8085

SWI_TITILER_API_ROUTE=/tiles/


# Staging password protection (HTTP basic auth on every public router).
# Leave both unset in production: the default no-op middleware (swi-open) is used.
# Staging: SWI_AUTH_MIDDLEWARE=swi-gate and SWI_BASICAUTH_USERS=<htpasswd lines, comma
# separated>, e.g. generated with `htpasswd -nbB user password`. Put the value in single
# quotes in a .env file ('user:$2y$05$...') or double every `$` ($$) elsewhere, and check
# with `docker compose config`.
# SWI_AUTH_MIDDLEWARE=swi-gate
# SWI_BASICAUTH_USERS='user:$2y$05$replaceMe'


# Frontend (swi-frontend). Pick ONE of the two modes below.
NUXT_PUBLIC_MAP_DEFAULT_OPACITY=100
NUXT_PUBLIC_MAP_DEFAULT_LOCATION_X=78.2
NUXT_PUBLIC_MAP_DEFAULT_LOCATION_Y=15.6

# Same-origin proxy mode (local default and staging): the browser only talks to the
# frontend host and the frontend server proxies to the services over the internal
# network, so there is no CORS and one basic-auth login covers everything.
NUXT_PUBLIC_ENDPOINTS_API_METOBS=/api/v3
NUXT_PUBLIC_ENDPOINTS_API_TILES=/tiles
NUXT_PUBLIC_ENDPOINTS_API_ELEVATION=/oeapi/v1
NUXT_PUBLIC_ENDPOINTS_MAPSERVERS_MAPPROXY=/mapserver
NUXT_BACKEND_METOBS=http://met-public-api:8085/v3
NUXT_BACKEND_TILES=http://titiler-cache
NUXT_BACKEND_ELEVATION=http://elevation_api:5000/api
NUXT_BACKEND_MAPPROXY=http://mapproxy-server:8080

# Direct mode (production): the browser calls the api./mapserver. hosts itself. Leave
# NUXT_BACKEND_* unset and make sure CORS_ALLOWED_ORIGINS contains the frontend origin.
# NUXT_PUBLIC_ENDPOINTS_API_METOBS=https://api.example.org/public/v3
# NUXT_PUBLIC_ENDPOINTS_API_TILES=https://api.example.org/tiles
# NUXT_PUBLIC_ENDPOINTS_API_ELEVATION=https://api.example.org/oeapi/v1
# NUXT_PUBLIC_ENDPOINTS_MAPSERVERS_MAPPROXY=https://mapserver.example.org


#APIs key
SWI_METOBS_HOLFUY_API_KEY=TheHolfuyAPIKey
SWI_METOBS_FROST_API_KEY=TheFrostAPIKey

# TLS: certificate resolver used by every router for automatic certificates (Let's Encrypt).
# Unset = Dokploy's "letsencrypt" resolver. Set it to another name if your Traefik uses one,
# or to an empty value (TRAEFIK_CERT_RESOLVER=) for local testing without Let's Encrypt.
# TRAEFIK_CERT_RESOLVER=letsencrypt

# Security headers (shared swi-sechdrs middleware). HSTS max-age in seconds.
# Local dev uses 0 so the self-signed *.localhost cert stays click-through-able.
# In production set a real value in Dokploy: start ~300 to confirm, then raise
# toward 15768000 (6 months). Unset falls back to the compose default of 300.
SWI_HSTS_SECONDS=0

# Rate limiting (per source IP) on the metobs and elevation APIs (swi-ratelimit).
# average=0 disables it (local dev); production leaves it unset to use the compose
# default (30/s, burst 60) or sets its own here / in Dokploy.
SWI_RATELIMIT_AVG=0
SWI_RATELIMIT_BURST=60
